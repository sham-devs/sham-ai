{
    "name": "sham/ai",
    "description": "AI Service package for Sham platforms",
    "license": "MIT",
    "authors": [
        {
            "name": "Basel",
            "email": "basel@sham.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "prism-php/prism": "^0.99.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "orchestra/testbench": "^9.0",
        "mockery/mockery": "^1.6|^2.0"
    },
    "autoload": {
        "psr-4": {
            "Sham\\AI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sham\\AI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "stan": "vendor/bin/phpstan analyse",
        "pint": "vendor/bin/pint fix",
        "pint:test": "vendor/bin/pint test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sham\\AI\\AIServiceProvider"
            ]
        }
    }
}
